{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_REMOTE:-}\" = true ] && exec \"$CLAUDE_PROJECT_DIR\"/scripts/setup.sh || exit 0"
          }
        ]
      }
    ]
  }
}
